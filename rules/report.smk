# ============================================================
# 报告生成模块: HTML 分析报告
# ============================================================

rule generate_report:
    """生成 HTML 分析报告"""
    input:
        qc_report     = f"{RESULT_DIR}/02.clean_data/multiqc_report.html",
        align_stat    = f"{RESULT_DIR}/03.align/align_stat_all.txt",
        gene_count    = f"{RESULT_DIR}/05.expression/gene/gene_count.xls",
        gene_norm     = f"{RESULT_DIR}/05.expression/gene/gene_{config['expression']['count_norm']}.xls",
        pca_plot      = f"{RESULT_DIR}/06.de_enrich/PCA.pdf",
        corr_plot     = f"{RESULT_DIR}/06.de_enrich/correlation_heatmap.pdf",
    output:
        summary_html = f"{RESULT_DIR}/report/analysis_report.html",
    params:
        project_id    = config["project"]["id"],
        project_title = config["project"]["title"],
        species       = config["project"]["species"],
        outdir        = f"{RESULT_DIR}/report",
    conda:
        f"{PIPELINE_DIR}/envs/report.yaml"
    run:
        import os, subprocess, sys
        os.makedirs(f"{params.outdir}", exist_ok=True)
        r_code = """
        import os
        
        html = '''<!DOCTYPE html>
        <html>
        <head>
            <meta charset=\"UTF-8\">
            <title>__SNK_0__ - RNA-seq Analysis Report</title>
            <style>
                body { font-family: Arial, sans-serif; max-width: 1200px; margin: auto; padding: 20px; }
                .section { margin: 30px 0; border: 1px solid #ddd; border-radius: 8px; padding: 20px; }
                .section h2 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 10px; }
                table { border-collapse: collapse; width: 100%; margin: 10px 0; }
                th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
                th { background-color: #3498db; color: white; }
                .stat-box { display: inline-block; margin: 10px; padding: 15px; background: #f0f8ff; border-radius: 5px; text-align: center; min-width: 120px; }
                .stat-value { font-size: 24px; font-weight: bold; color: #2c3e50; }
                .stat-label { font-size: 12px; color: #7f8c8d; }
                img { max-width: 100%; height: auto; }
            </style>
        </head>
        <body>
            <h1>__SNK_0__</h1>
            <p>Project ID: __SNK_2__ | Species: __SNK_3__</p>
        
            <div class=\"section\">
                <h2>1. Data Quality Control</h2>
                <p>Fastp + FastQC quality control results are available in the <a href=\"../02.clean_data/multiqc_report.html\">MultiQC Report</a>.</p>
                <iframe src=\"../02.clean_data/multiqc_report.html\" width=\"100%\" height=\"500\" style=\"border:none;\"></iframe>
            </div>
        
            <div class=\"section\">
                <h2>2. Alignment Statistics</h2>
                <p>Alignment statistics for all samples:</p>
                <p><a href=\"../03.align/align_stat_all.txt\">Detailed alignment statistics</a></p>
            </div>
        
            <div class=\"section\">
                <h2>3. Expression Analysis</h2>
                <p><a href=\"../05.expression/gene/\">Gene expression matrices</a></p>
            </div>
        
            <div class=\"section\">
                <h2>4. Differential Expression Analysis</h2>
                <p>PCA plot:</p>
                <img src=\"../06.de_enrich/PCA.png\" alt=\"PCA Plot\" style=\"max-width:600px;\">
                <p>Sample correlation heatmap:</p>
                <img src=\"../06.de_enrich/correlation_heatmap.png\" alt=\"Correlation Heatmap\" style=\"max-width:600px;\">
            </div>
        
            <div class=\"section\">
                <h2>5. Enrichment Analysis</h2>
                <p>GO and KEGG enrichment results are available in the <a href=\"../06.de_enrich/\">differential analysis directory</a>.</p>
            </div>
        
            <footer style=\"text-align:center; margin-top:30px; color:#95a5a6; font-size:12px;\">
                Generated by EasyRNASeq v2.0 | __SNK_0__
            </footer>
        </body>
        </html>'''
        
        with open('__SNK_1__', 'w') as f:
            f.write(html)
        print(f'Report generated: __SNK_1__')
        
        """
        r_code = r_code.replace("__SNK_0__", str(params.project_title))
        r_code = r_code.replace("__SNK_1__", str(output.summary_html))
        r_code = r_code.replace("__SNK_2__", str(params.project_id))
        r_code = r_code.replace("__SNK_3__", str(params.species))
        r_code = r_code.replace("__SNK_4__", str(params.outdir))
        result = subprocess.run(["python3", "-c", r_code], text=True, capture_output=True)
        if result.returncode != 0:
            print(result.stderr, file=sys.stderr)
            raise Exception(f"Script failed (exit {result.returncode})")
        if result.stdout:
            print(result.stdout, end="")
